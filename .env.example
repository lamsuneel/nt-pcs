# Copy this file to .env and fill in real values before running the app.

# Postgres connection string backing the lean demo DB (documents,
# print_requests, controlled_copies). Any Postgres 14+ works — the deployed
# demo uses Neon. If unset or unreachable, the page falls back to static
# in-memory demo data so it never breaks mid-pitch.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

NODE_ENV=production
