# Copy this file to .env and fill in real values before running the app.

# Postgres connection string. Any Postgres 14+ works (Neon, Supabase, Railway,
# RDS, a local Docker container — see docker-compose.yml for a quick local one).
DATABASE_URL=postgresql://ntpcs:CHANGE_ME@localhost:5432/ntpcs

# Not currently used by any route (provisioned for the spec's queue/notification
# requirement, no worker consumes it yet in this MVP) — safe to leave unset.
REDIS_URL=redis://localhost:6379

# Signs session cookies. Generate a real one: `openssl rand -base64 48`
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Public URL the app is served at — used to build the QR-code verify links
# baked into generated PDFs. Must match wherever you deploy this.
APP_BASE_URL=http://localhost:3000

NODE_ENV=production
